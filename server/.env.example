PORT=5000
MONGODB_URI=
JWT_SECRET=
CLIENT_URL=http://localhost:5173

IMAGEKIT_PRIVATE_KEY=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CodeSphere
OTP_HASH_SECRET=

CONTACT_RECEIVER_EMAIL=

# Code runner for Reverse Coding and Playground challenges.
# Default: the free public Wandbox API (no key needed).
# CODE_RUNNER=judge0|wandbox|off forces one. WANDBOX_CONCURRENCY limits parallel requests (default 2).
CODE_RUNNER=
WANDBOX_CONCURRENCY=2
# Optional Judge0 instead of Wandbox: a self-hosted URL, or a RapidAPI key
# (https://rapidapi.com/judge0-official/api/judge0-ce, URL https://judge0-ce.p.rapidapi.com).
JUDGE0_URL=
JUDGE0_API_KEY=

# Tech News: fetch active feeds every N hours (default 24); set NEWS_SCHEDULER=off to disable
NEWS_FETCH_HOURS=24
NEWS_SCHEDULER=on
# Live hackathons from Devpost, Devfolio, Unstop, Hack2Skill, HackerEarth (free public data, every 6h). Set to off to disable.
HACKATHON_SYNC=on
# Project Hub GitHub import: optional token (no scopes needed) raises GitHub's limit from 60 to 5000 requests/hour.
# Server-side only; never put it in the client .env.
GITHUB_TOKEN=
# Optional "Connect GitHub" (verify project ownership). Create an OAuth App at
# https://github.com/settings/developers with callback URL {API_PUBLIC_URL}/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Daily refresh of published projects' GitHub details (on/off)
PROJECT_SYNC=on
# Daily tech news (Hacker News, DEV, RSS: no keys needed). Set DAILY_NEWS=off to disable.
DAILY_NEWS=on
DAILY_NEWS_SYNC_HOURS=3
# "Today in Tech" notification + email at this hour (IST)
DAILY_BRIEF_HOUR=8
DAILY_NEWS_KEEP_DAYS=21
# Brevo free plan = 300 emails/day; cap daily emails below that
DAILY_EMAIL_LIMIT=250
# Optional free keys for more sources: https://gnews.io and https://newsdata.io
GNEWS_API_KEY=
NEWSDATA_API_KEY=
# Auto-publish the weekly Tech Brief on Monday 9 AM IST if editors haven't (on/off)
NEWS_AUTO_DIGEST=off
# Public URL of this API (used for newsletter unsubscribe links), e.g. https://api.example.com/api
API_PUBLIC_URL=
